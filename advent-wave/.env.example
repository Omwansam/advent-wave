# Origin of the AdventWave gateway.
#
# Leave this unset in development: vite.config.js proxies /v1 to VITE_API_PROXY_TARGET
# (default http://localhost:8080), so the browser talks to one origin and no CORS
# preflight happens. Set it for production builds, where there is no dev-server proxy.
#
# VITE_API_BASE_URL=https://api.adventwave.app

# Where the dev-server proxy forwards /v1. Only needed if the gateway is not on :8080.
# VITE_API_PROXY_TARGET=http://localhost:8080
