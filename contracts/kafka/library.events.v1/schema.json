{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.adventwave.app/kafka/library.events.v1/schema.json",
  "title": "library.events.v1",
  "description": "A change to one user's library: a like toggled, an artist or playlist followed or unfollowed. Three shapes, discriminated by `action`. The envelope (outbox row) carries event_id and created_at; the payload does not repeat them.",
  "x-adventwave": {
    "status": "implemented",
    "producer": "platform-core LibraryService via outbox",
    "consumers": [
      "workstream F (features)"
    ],
    "key": "user_id",
    "compaction": false,
    "source": "backend/platform-core/src/main/java/org/adventwave/platform/library/LibraryService.java"
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "action",
        "media_item_id",
        "collection"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "type": "string",
          "enum": [
            "liked",
            "unliked"
          ]
        },
        "media_item_id": {
          "type": "string",
          "format": "uuid"
        },
        "collection": {
          "type": "string",
          "enum": [
            "liked_songs",
            "saved_sermons"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "action",
        "artist_id"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "type": "string",
          "enum": [
            "followed_artist",
            "unfollowed_artist"
          ]
        },
        "artist_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "action",
        "playlist_id"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "type": "string",
          "enum": [
            "followed_playlist",
            "unfollowed_playlist"
          ]
        },
        "playlist_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  ]
}
