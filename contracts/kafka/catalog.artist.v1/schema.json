{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.adventwave.app/kafka/catalog.artist.v1/schema.json",
  "title": "catalog.artist.v1",
  "description": "Current state of one artist. Fields mirror artists columns. Compacted by artist_id.",
  "x-adventwave": {
    "status": "implemented",
    "producer": "gateway CatalogAdminService via outbox (POST/PUT /v1/admin/artists)",
    "consumers": [
      "workstream B",
      "workstream F"
    ],
    "key": "artist_id",
    "compaction": true,
    "source": "artists columns in contracts/postgres/schema.sql"
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artist_id",
        "name",
        "slug",
        "verified"
      ],
      "properties": {
        "artist_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "description": "Unique across the catalogue (artists_name_unique)."
        },
        "slug": {
          "type": "string"
        },
        "cover_url": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "church_id": {
          "type": "string",
          "format": "uuid",
          "description": "Contributing church. Omitted when unknown."
        },
        "verified": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "enum": [
            "church",
            "choir",
            "group",
            "soloist",
            "preacher",
            "ministry"
          ],
          "description": "What the profile is (RFC 0009, contracts 1.8.0). Absent on messages from before 1.8.0, which mean choir."
        },
        "ensemble": {
          "type": "string",
          "enum": [
            "main",
            "youth",
            "children",
            "women",
            "men",
            "other"
          ],
          "description": "Which of a church's choirs; present only when kind is choir."
        },
        "home_church_id": {
          "type": "string",
          "format": "uuid",
          "description": "The church profile (an artist of kind church) this one belongs to. Absent: a church, or an independent profile."
        },
        "conference_id": {
          "type": "string",
          "description": "conferences.id: the conference, field or union the profile sits in."
        },
        "location": {
          "type": "string",
          "description": "Town or area, as the profile gives it."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artist_id",
        "deleted"
      ],
      "properties": {
        "artist_id": {
          "type": "string",
          "format": "uuid"
        },
        "deleted": {
          "type": "boolean",
          "const": true
        }
      }
    }
  ]
}
