# /etc/systemd/system/adventwave-backup.timer
#   sudo systemctl enable --now adventwave-backup.timer && systemctl list-timers adventwave-backup
[Unit]
Description=Nightly AdventWave database backup

[Timer]
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
