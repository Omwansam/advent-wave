# /etc/adventwave/gateway.env — the gateway's settings on the server.
#
# Copy to /etc/adventwave/gateway.env, fill in every <...> (without the brackets), then:
#   sudo chown root:adventwave /etc/adventwave/gateway.env && sudo chmod 640 /etc/adventwave/gateway.env
#
# The gateway refuses to start while any of these is missing or still a development value
# (DevDefaultsGuard); the log names each one. One setting per line, no quotes, no comments
# after a value: systemd reads the rest of the line as the value. Generate every secret with:
#   openssl rand -base64 48

# ------------------------------------------------------------------ hosts
# The two sites Caddy serves. Both proxy /v1 to the gateway, so the browser talks to one origin
# and the web apps are built with no API URL of their own.
ADVENTWAVE_APP_BASE_URL=https://<listen.example.org>
ADVENTWAVE_API_BASE_URL=https://<listen.example.org>
ADVENTWAVE_CORS_ORIGINS=https://<listen.example.org>,https://<admin.example.org>

# Only Caddy talks to the gateway, and it says who the client was.
SERVER_ADDRESS=127.0.0.1
PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=native

# ------------------------------------------------------------------ database
ADVENTWAVE_DB_URL=jdbc:postgresql://localhost:5432/adventwave
ADVENTWAVE_DB_USER=adventwave
ADVENTWAVE_DB_PASSWORD=<database password>

# ------------------------------------------------------------------ secrets (each different)
ADVENTWAVE_DEV_ISSUER=false
ADVENTWAVE_LISTENER_TOKEN_SECRET=<openssl rand -base64 48>
ADVENTWAVE_ADMIN_TOKEN_SECRET=<openssl rand -base64 48>
ADVENTWAVE_SIGNING_SECRET=<openssl rand -base64 48>

# The first super admin, created at startup only while no admin account exists. Remove both
# lines once you have signed in to the admin portal and changed the password.
ADVENTWAVE_ADMIN_BOOTSTRAP_EMAIL=<you@example.org>
ADVENTWAVE_ADMIN_BOOTSTRAP_PASSWORD=<a long temporary password>

# ------------------------------------------------------------------ email (password reset, verification)
ADVENTWAVE_MAIL_MODE=smtp
# The address must be one your SMTP provider lets you send from.
ADVENTWAVE_MAIL_FROM=AdventWave <no-reply@listen.example.org>
SPRING_MAIL_HOST=<smtp.provider.example>
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<smtp user>
SPRING_MAIL_PASSWORD=<smtp password>
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true

# ------------------------------------------------------------------ object storage (RFC 0006)
# Any S3-compatible service. Two private buckets; see deploy/README.md for their CORS rule.
ADVENTWAVE_STORAGE_MODE=s3
# The provider's S3 endpoint; leave empty for AWS S3 itself.
ADVENTWAVE_S3_ENDPOINT=<https://s3.region.provider.example>
ADVENTWAVE_S3_REGION=<region>
ADVENTWAVE_S3_ACCESS_KEY=<access key>
ADVENTWAVE_S3_SECRET_KEY=<secret key>
ADVENTWAVE_S3_MASTERS_BUCKET=<adventwave-masters>
ADVENTWAVE_S3_DERIVED_BUCKET=<adventwave-derived>
# true for MinIO and some providers; false for AWS, R2, Spaces, B2.
ADVENTWAVE_S3_PATH_STYLE=false
ADVENTWAVE_S3_STAGING_DIR=/var/lib/adventwave/transcode

# ------------------------------------------------------------------ transcoding, in this process
ADVENTWAVE_LOCAL_WORKER=true
ADVENTWAVE_TRANSCODE_SCRIPT=/opt/adventwave/current/tools/transcode.py

# ------------------------------------------------------------------ Redis (cache and rate limits)
ADVENTWAVE_REDIS_HOST=localhost
ADVENTWAVE_REDIS_PORT=6379
