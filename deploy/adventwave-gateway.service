# /etc/systemd/system/adventwave-gateway.service
#
#   sudo systemctl daemon-reload && sudo systemctl enable --now adventwave-gateway
#   journalctl -u adventwave-gateway -f
[Unit]
Description=AdventWave gateway
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=adventwave
Group=adventwave
EnvironmentFile=/etc/adventwave/gateway.env
WorkingDirectory=/opt/adventwave/current
# Sized for a 4 GB server shared with Postgres and Redis; raise -Xmx on a bigger one.
ExecStart=/usr/bin/java -Xms256m -Xmx1g -XX:+ExitOnOutOfMemoryError -jar /opt/adventwave/current/gateway.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

# /var/lib/adventwave: the transcode staging directory, the only place it writes.
StateDirectory=adventwave
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/adventwave

[Install]
WantedBy=multi-user.target
