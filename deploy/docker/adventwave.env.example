# $AW_HOME/adventwave.env (default /srv/adventtwave/adventwave.env): the gateway's settings and the
# database password, read by deploy/docker/compose.yml. Mode 600, never in git.
#
# install.sh writes this file on first run, with fresh secrets and every value below; edit it
# afterwards and apply with ./aw up -d. One setting per line, no quotes. Secrets: openssl rand -hex 32
#
# The gateway refuses to start while a value here is a development default (DevDefaultsGuard).

# ------------------------------------------------------------------ hosts (both behind the edge proxy)
ADVENTWAVE_APP_BASE_URL=https://<app host>
ADVENTWAVE_API_BASE_URL=https://<app host>
ADVENTWAVE_CORS_ORIGINS=https://<app host>,https://<admin host>

# ------------------------------------------------------------------ secrets, each different
ADVENTWAVE_DB_PASSWORD=<openssl rand -hex 32>
ADVENTWAVE_DEV_ISSUER=false
ADVENTWAVE_LISTENER_TOKEN_SECRET=<openssl rand -hex 32>
ADVENTWAVE_ADMIN_TOKEN_SECRET=<openssl rand -hex 32>
ADVENTWAVE_SIGNING_SECRET=<openssl rand -hex 32>

# The first super admin, created at startup only while no admin account exists. Delete both lines
# once you have signed in to the admin portal and changed the password.
ADVENTWAVE_ADMIN_BOOTSTRAP_EMAIL=<you@example.org>
ADVENTWAVE_ADMIN_BOOTSTRAP_PASSWORD=<openssl rand -hex 16>

# ------------------------------------------------------------------ email (reset and verification links)
ADVENTWAVE_MAIL_MODE=smtp
ADVENTWAVE_MAIL_FROM=AdventWave <no-reply@<app host>>
SPRING_MAIL_HOST=<smtp host>
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<smtp user>
SPRING_MAIL_PASSWORD=<smtp password>
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true

# ------------------------------------------------------------------ object storage (RFC 0006)
ADVENTWAVE_STORAGE_MODE=s3
ADVENTWAVE_S3_ENDPOINT=<https://… ; empty for AWS S3>
ADVENTWAVE_S3_REGION=<region; auto for Cloudflare R2>
ADVENTWAVE_S3_ACCESS_KEY=<access key>
ADVENTWAVE_S3_SECRET_KEY=<secret key>
ADVENTWAVE_S3_MASTERS_BUCKET=<masters bucket>
ADVENTWAVE_S3_DERIVED_BUCKET=<derived bucket>
ADVENTWAVE_S3_PATH_STYLE=false
