# AdventWave — HTTPS. Rendered by deploy/docker/enable-https.sh once the certificate exists.
#
# No `upstream` blocks: the hostnames sit in variables so nginx resolves them per request through
# the proxy's resolver (127.0.0.11). An AdventWave container that is stopped or rebuilt then costs
# a 502 on these two hosts, never a proxy that will not start.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __APP_HOST__;

    ssl_certificate     /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
    include /etc/nginx/conf.d/ssl-params.conf;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;

    limit_conn conn_limit 50;
    set $aw_gateway http://adventwave-gateway:8080;
    set $aw_web     http://adventwave-web:80;

    # The gateway limits sign-in per address itself (RFC 0005); this is the proxy's coarser guard.
    location /v1/auth/ {
        limit_req zone=auth_limit burst=20 nodelay;
        proxy_pass $aw_gateway;
    }
    location /v1/ {
        limit_req zone=api_limit burst=60 nodelay;
        proxy_pass $aw_gateway;
    }
    location / {
        proxy_pass $aw_web;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __ADMIN_HOST__;

    ssl_certificate     /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
    include /etc/nginx/conf.d/ssl-params.conf;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;
    add_header X-Robots-Tag              "noindex, nofollow" always;

    limit_conn conn_limit 50;
    set $aw_gateway http://adventwave-gateway:8080;
    set $aw_admin   http://adventwave-web:81;

    location /v1/auth/ {
        limit_req zone=auth_limit burst=20 nodelay;
        proxy_pass $aw_gateway;
    }
    location /v1/ {
        limit_req zone=api_limit burst=60 nodelay;
        proxy_pass $aw_gateway;
    }
    location / {
        proxy_pass $aw_admin;
    }
}
