<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.3</version>
    <relativePath/>
  </parent>

  <groupId>org.adventwave</groupId>
  <artifactId>adventwave-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>AdventWave Backend</name>
  <description>
    Modular monolith. Module boundaries mirror the workstream charters in BACKEND_BUILD_PLAN.md §3
    so each module can be lifted into its own deployable without a rewrite.
  </description>

  <!--
    Java 21 LTS and Spring Boot 3.5.3 are the pinned versions required by
    BACKEND_BUILD_PLAN.md §1 pre-work ("Pin the exact Java and Spring Boot versions on day 5").
    Changing either follows the §7 RFC process.
  -->
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>contracts</module>
    <module>platform-core</module>
    <module>catalog-service</module>
    <module>reco-service</module>
    <module>gateway</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.adventwave</groupId>
        <artifactId>contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.adventwave</groupId>
        <artifactId>platform-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.adventwave</groupId>
        <artifactId>catalog-service</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.adventwave</groupId>
        <artifactId>reco-service</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Pin the JDK for the build itself, not just the bytecode target. maven.compiler.release
        above makes javac emit 21; this makes Maven use a real JDK 21 to do it, so a shell whose
        default java is 17 no longer needs JAVA_HOME set by hand before every command.

        The JDK is located through ~/.m2/toolchains.xml. Generate one for this machine with:

            ./mvnw -N toolchains:generate-jdk-toolchains-xml \
                   -Dtoolchain.file=$HOME/.m2/toolchains.xml

        If no JDK 21 is registered the build stops with "Cannot find matching toolchain", which
        is a clearer failure than the class-version error you would otherwise hit at run time.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <goals>
              <goal>select-jdk-toolchain</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <version>[21,22)</version>
        </configuration>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
