# AdventWave backend — local configuration.
#
# Spring Boot does NOT read this file by itself. It is read by ./run-local.sh, which
# exports every line as an environment variable before starting the JVM. Every name below
# is already wired into gateway/src/main/resources/application.yml as a ${VAR:default}
# placeholder, so an exported variable always wins over the default in that file.
#
# Copy to .env and edit. .env is git-ignored; this template is committed.

# --- Database -----------------------------------------------------------------------
# THIS is the database URL. Plain JDBC — host, port, database name.
#
# The default in application.yml is port 5434, which is the docker-compose Postgres.
# Running without Docker means pointing this at a Postgres you installed yourself.
# On this machine the Debian-managed cluster 16/main listens on 5433 (`pg_lsclusters`).
ADVENTWAVE_DB_URL=jdbc:postgresql://localhost:5433/adventwave
ADVENTWAVE_DB_USER=adventwave
ADVENTWAVE_DB_PASSWORD=adventwave

# When you move to a server, this is the only line that changes, e.g.
#   ADVENTWAVE_DB_URL=jdbc:postgresql://db.internal:5432/adventwave?sslmode=require

# --- Redis --------------------------------------------------------------------------
# Optional. Redis is a cache and a write buffer here, never a source of truth: every call
# site catches its own failure and falls through to Postgres. The app boots and serves
# correctly with no Redis running — it is only slower, /actuator/health reports DOWN, and
# PlayerStateService logs one warning per 30s flush tick.
#
# To silence that without installing Redis, uncomment the health line below.
ADVENTWAVE_REDIS_HOST=localhost
ADVENTWAVE_REDIS_PORT=6379
#MANAGEMENT_HEALTH_REDIS_ENABLED=false

# --- HTTP ---------------------------------------------------------------------------
PORT=8080
ADVENTWAVE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADVENTWAVE_API_BASE_URL=http://localhost:8080

# --- Auth and signing ---------------------------------------------------------------
# Dev token issuance stands in for the managed IdP. MUST be false in production; setting
# spring.security.oauth2.resourceserver.jwt.issuer-uri retires it entirely.
ADVENTWAVE_DEV_ISSUER=true
ADVENTWAVE_DEV_SECRET=dev-only-secret-at-least-32-bytes-long-change-me
ADVENTWAVE_SIGNING_SECRET=dev-only-playback-signing-secret-change-me
